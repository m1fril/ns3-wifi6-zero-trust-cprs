exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-wifi
Description: 
URL: 
Version: 3.46.1
Requires:  ns3-energy ns3-spectrum
Requires.private: 
