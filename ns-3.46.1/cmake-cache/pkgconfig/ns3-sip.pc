exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-sip
Description: 
URL: 
Version: 3.46.1
Requires:  ns3-core ns3-network ns3-internet
Requires.private: 
Cflags: -I"${includedir}"  -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/libxml2 -I/opt/homebrew/include
Libs: -L"${libdir}" -lns3.46.1-sip-optimized  -lns3.46.1-core-optimized -lns3.46.1-network-optimized -lns3.46.1-internet-optimized
Libs.private: -L"${libdir}" 
